# Copie este archivo como .env (solo en su computadora; .env NUNCA va al GitHub).
# En Render cree estas mismas variables en el panel del servicio.

# Supabase › Project Settings › Data API › Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase › Project Settings › API Keys › Secret key (sb_secret_…). Secreta: solo en el servidor.
SUPABASE_SECRET_KEY=

# Opcional: otros sitios que pueden llamar a la API (separados por coma). Vacío = solo el propio sitio.
ALLOWED_ORIGINS=
# Opcional: texto aleatorio para el hash de las IP (por defecto usa la clave secreta)
IP_HASH_SALT=
# Puerto local (la nube define PORT sola)
PORT=3000
