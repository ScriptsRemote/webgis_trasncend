{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-banco.js\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Verificando proteção do banco…"
          }
        ]
      }
    ]
  }
}
